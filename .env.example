# NASA FIRMS MAP_KEY (required for fire detections)
NASA_FIRMS_MAP_API_KEY=

# Optional general NASA API key (not required by POWER or FIRMS area endpoint)
NASA_API_KEY=

# Postgres connection string (local Homebrew Postgres or Supabase)
# Local example: postgresql+psycopg://USER@localhost:5432/shadecast
# Supabase example: postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/shadecast

# Featherless LLM (OpenAI-compatible)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL_ID=zai-org/GLM-5.2
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# App
DEMO_MODE=0
STALE_AFTER_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase metadata (schema also applied via MCP)
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
